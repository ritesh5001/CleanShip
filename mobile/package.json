    "@react-native-community/netinfo": "12.0.1",
    "expo": "~57.0.19",
    "expo-constants": "~57.0.17",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.18",
    "expo-status-bar": "~57.0.1",
