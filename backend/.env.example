# Copy this to backend/.env and fill it in. That file is gitignored.
#
# backend/.env is the ONE configuration file for the whole system — both the
# backend scripts and the Next.js app read it. Next normally only reads .env
# files in its own directory; ../frontend/next.config.ts loads this one
# explicitly so configuration lives beside the code that owns it, and so there
# is never a second copy drifting out of step.
#
# Values already present in the environment always win, so a host's dashboard
# variables (Vercel, Render) override this file. In production this file does
# not exist at all, and that is fine — a missing file is a no-op.

# Neon Postgres.
DATABASE_URL=

# Signs the session cookie. At least 32 characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Absolute origin of the marketing site.
APP_URL=http://localhost:3000

# Where CleanTrack is served. Customer share links are built from this, so a
# wrong value sends every link you issue to the wrong host.
CLEANTRACK_URL=http://localhost:3000/cleantrack

# Scopes the session cookie so ONE sign-in works across the site and the
# CleanTrack subdomain. Production only — leave unset locally, where
# everything is on localhost and a host-only cookie is correct.
# COOKIE_DOMAIN=.cleanship.co

# ---------------------------------------------------------------------------
# DO NOT ADD THESE. They were the old Express API's and are read by nothing:
#
#   JWT_SECRET             renamed to SESSION_SECRET in the auth refactor
#   CORS_ORIGINS           there is no cross-origin API any more
#   ADMIN_BOOTSTRAP_TOKEN  replaced by: npm run db:bootstrap
#   PORT                   Next uses 3000, or $PORT on a host
#
#   NODE_ENV               Next sets this itself. Pinning it breaks two things
#                          in production: session cookies stop being
#                          Secure-only, and GA4 silently never loads.
# ---------------------------------------------------------------------------
