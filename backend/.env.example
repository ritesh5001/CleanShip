# ---------------------------------------------------------------------------
# CleanTrack API — backend/.env
#
# Copy to backend/.env for local development. On Render these are set on the
# service (Environment → Environment Variables), and no .env file exists.
# ---------------------------------------------------------------------------

# Postgres. Production is Neon, NOT a Render-managed database — render.yaml
# has no `databases:` block on purpose, because one would provision a second
# empty instance and wire the API to it.
#
# Use Neon's POOLED connection string and keep `?sslmode=require`:
# src/db/index.ts keys its TLS settings off that substring.
#
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
#
# There is one database and no staging instance, so a local run with this set
# is working on production data.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cleanship

# Signs session tokens. MUST be identical on this service and on the Vercel
# frontend, because the frontend verifies these tokens locally instead of
# calling this API on every page render.
#
# Generate one with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-at-least-32-characters-of-random

# How long a sign-in lasts. Crews work long shifts; a day is deliberate.
SESSION_TTL_HOURS=24

# Browsers allowed to call this API directly. Comma separated, no trailing
# slash. Server-side calls from Next carry no Origin header and are never
# subject to CORS, so this only covers direct browser use.
#
# Both live hosts belong here: the office manages vessels from
# www.cleanship.co and crews use cleantrack.cleanship.co.
CORS_ORIGINS=http://localhost:3000,https://cleantrack.cleanship.co,https://www.cleanship.co,https://cleanship.co

# Where customer share links point. Used to build the link the admin copies —
# get it wrong and every link you issue goes to the wrong host, and you will
# not find out until a customer says so. Production: https://cleantrack.cleanship.co
CLEANTRACK_URL=http://localhost:3000/cleantrack

# Port. Render sets this itself; only used locally.
PORT=4000

# ---------------------------------------------------------------------------
# First admin, created by `npm run seed`. Optional: leave the password unset
# and the script prints a generated one to the log exactly once.
#
# The seed is idempotent — it never resets an account that already exists. To
# change a password from the command line (there is no email reset flow):
#
#   npm run set-password -- someone@cleanship.co
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@cleanship.co
SEED_ADMIN_NAME=CleanShip Admin
# SEED_ADMIN_PASSWORD=
