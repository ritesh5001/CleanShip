# ---------------------------------------------------------------------------
# Cleanship API — copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Neon Postgres connection string.
# Neon dashboard -> your project -> Connection Details -> "Connection string".
# Keep ?sslmode=require — Neon rejects unencrypted connections.
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/cleanship?sslmode=require

# Signing secret for admin session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Rotating it logs everyone out.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Comma-separated origins allowed to call this API with credentials.
# The site's dev server and its production domain.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://www.cleanship.co

# One-time bootstrap for the first admin account. POST /api/auth/bootstrap
# with this token to create the initial user, then delete this variable —
# the endpoint refuses to run once any user exists.
ADMIN_BOOTSTRAP_TOKEN=replace-me-with-another-long-random-string
