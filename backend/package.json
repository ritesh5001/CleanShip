{
  "name": "@cleanship/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Database, auth and CleanTrack domain logic. Consumed by the Next app in ../frontend; not a separate service.",
  "type": "module",
  "exports": {
    "./db": "./src/db/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "node scripts/not-a-service.mjs",
    "start": "node scripts/not-a-service.mjs",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.6",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.5",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
