# ---------------------------------------------------------------------------
# Hold Watch
# ---------------------------------------------------------------------------

# THE SAME DATABASE AS THE MARKETING API. Copy DATABASE_URL from backend/.env
# verbatim — one Neon instance serves both, by design.
#
# This is safe because of two things, and it stops being safe if either is
# removed:
#
#   1. Every Hold Watch table is prefixed `hw_` (src/lib/db/schema.ts).
#   2. drizzle.config.ts sets tablesFilter: ["hw_*"], so drizzle-kit cannot
#      see — and therefore cannot drop — the marketing API's tables.
#
# If you ever add a table here without the `hw_` prefix, it falls outside that
# filter and the next `db:push` from the other project may drop it.
DATABASE_URL=

# Signs the session cookie. At least 32 characters, and DIFFERENT from the
# marketing API's JWT_SECRET — sharing a database does not mean sharing a
# signing key, and a leak of one should not forge sessions in the other.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Absolute origin. Client share links are built from this, so if it is wrong
# every link you send points at the wrong host.
APP_URL=http://localhost:3200
