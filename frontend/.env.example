
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The DOMAIN MUST BE VERIFIED in the Resend dashboard
# (Domains → Add Domain → add the DKIM/SPF/MX records to your DNS).
# Resend rejects sends from unverified domains — this is the single most
# common reason a form "works locally but not in production".
#
# cleanship.ae must be added and verified as its own domain in Resend —
# it is unrelated to the cleanship.co domain/DKIM setup.
RESEND_FROM_EMAIL="Cleanship Sales <sales@cleanship.ae>"

# Where enquiries are delivered.
#
# ⚠️ THIS OVERRIDES siteConfig.email. If it is set in Vercel, enquiries go
# here regardless of what the site displays. Leave it UNSET to use the single
# public address in src/lib/site.ts (admin@cleanship.co) — that is the simpler
# setup and it guarantees the address shown on the site is the address that
# receives.

# Set it only when the delivery inbox genuinely differs from the published
# one — for example routing into a shared helpdesk.
# ENQUIRY_TO_EMAIL=admin@cleanship.co

# ---------------------------------------------------------------------------
# Google Analytics 4
#
# Optional. The measurement ID is hardcoded as a fallback in
# src/components/analytics.tsx because it is public anyway (it appears in the
# page source). Set this only to point a preview deployment at a separate
# property, or to move the ID out of the repo.
#
# The tag does NOT load when NODE_ENV is "development", so `npm run dev` never
# reaches the property regardless of this value.
# NEXT_PUBLIC_GA_ID=G-JTD0RRJZ50

# ---------------------------------------------------------------------------
# Cleanship API (backend/ — separate Express deploy on Render)
#
# Public because the browser calls it directly from /admin (cookie-based
# session, cross-origin). Local dev defaults to http://localhost:4000 if unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://cleanship.onrender.com
# ---------------------------------------------------------------------------
# Database, sessions and CleanTrack
#
# One database serves the whole system: the enquiry inbox and CleanTrack. There
# is no separate API service any more — the Express backend was retired when
# everything moved into this app.
# ---------------------------------------------------------------------------

DATABASE_URL=

# Signs the session cookie. At least 32 characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Absolute origin of the marketing site.
APP_URL=https://www.cleanship.co

# Where CleanTrack is served. Client share links are built from it, so a wrong
# value sends every link you issue to the wrong host.
CLEANTRACK_URL=https://cleantrack.cleanship.co

# Scopes the session cookie so ONE sign-in works on both the site and the
# CleanTrack subdomain. Set it to the parent domain WITH the leading dot.
# Leave unset locally, where everything is on localhost.
COOKIE_DOMAIN=.cleanship.co
