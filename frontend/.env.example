
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The DOMAIN MUST BE VERIFIED in the Resend dashboard
# (Domains → Add Domain → add the DKIM/SPF/MX records to your DNS).
# Resend rejects sends from unverified domains — this is the single most
# common reason a form "works locally but not in production".
#
# cleanship.ae must be added and verified as its own domain in Resend —
# it is unrelated to the cleanship.co domain/DKIM setup.
RESEND_FROM_EMAIL="Cleanship Sales <sales@cleanship.ae>"

# Where enquiries are delivered. Defaults to siteConfig.email if unset.
ENQUIRY_TO_EMAIL=sales@cleanship.ae

# ---------------------------------------------------------------------------
# Cleanship API (backend/ — separate Express deploy on Render)
#
# Public because the browser calls it directly from /admin (cookie-based
# session, cross-origin). Local dev defaults to http://localhost:4000 if unset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://cleanship.onrender.com