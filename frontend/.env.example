# ---------------------------------------------------------------------------
# frontend/.env.local
#
# Copy to frontend/.env.local for local development. In production these are
# set in the Vercel dashboard (Settings → Environment Variables).
# ---------------------------------------------------------------------------

# The CleanTrack API. Locally that is the backend/ service on its own port;
# in production it is the Render service's URL.
#
# NOT NEXT_PUBLIC_: every call to the API is made from the server, so the
# browser never talks to it and never needs to know where it is.
BACKEND_URL=http://localhost:4000

# Signs and verifies session tokens.
#
# ⚠️ MUST BE BYTE-IDENTICAL to SESSION_SECRET on the API. The API signs the
# token; this app verifies it locally so it can render the right screen
# without asking the API who you are on every page. Different values means
# every sign-in appears to work and then bounces straight back to the login
# page, which is a confusing hour to debug.
SESSION_SECRET=change-me-to-at-least-32-characters-of-random

# Scope for the session cookie. Set to ".cleanship.co" in production so one
# sign-in works on the site and on cleantrack.cleanship.co alike. Leave unset
# locally, where host-only on localhost is correct.
# COOKIE_DOMAIN=.cleanship.co

# ---------------------------------------------------------------------------
# Email — the public contact forms
# ---------------------------------------------------------------------------

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The DOMAIN MUST BE VERIFIED in the Resend dashboard
# (Domains → Add Domain → add the DKIM/SPF/MX records to your DNS). Resend
# rejects sends from unverified domains — the single most common reason a form
# "works locally but not in production".
RESEND_FROM_EMAIL="Cleanship Sales <sales@cleanship.ae>"

# Where enquiries are delivered.
#
# ⚠️ THIS OVERRIDES siteConfig.email. Leave it UNSET to use the single public
# address in src/lib/site.ts (admin@cleanship.co) — that is the simpler setup
# and it guarantees the address shown on the site is the address that
# receives. Set it only when the delivery inbox genuinely differs from the
# published one, such as routing into a shared helpdesk.
# ENQUIRY_TO_EMAIL=admin@cleanship.co

# ---------------------------------------------------------------------------
# Google Analytics 4
#
# Optional. The measurement ID is hardcoded as a fallback in
# src/components/analytics.tsx because it is public anyway (it appears in the
# page source). Set this only to point a preview deployment at a separate
# property, or to move the ID out of the repo.
#
# The tag does NOT load when NODE_ENV is "development", so `npm run dev` never
# reaches the property regardless of this value.
# NEXT_PUBLIC_GA_ID=G-JTD0RRJZ50
