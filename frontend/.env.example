# ---------------------------------------------------------------------------
# Contact form email delivery (Resend)
#
# Copy to .env.local and fill in. Without RESEND_API_KEY the contact form will
# reject submissions with an error rather than silently dropping them.
# ---------------------------------------------------------------------------

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The DOMAIN MUST BE VERIFIED in the Resend dashboard
# (Domains → Add Domain → add the DKIM/SPF records to your DNS).
# Resend rejects sends from unverified domains — this is the single most
# common reason a form "works locally but not in production".
RESEND_FROM_EMAIL="Cleanship Website <website@cleanship.co>"

# Where enquiries are delivered. Defaults to siteConfig.email if unset.
ENQUIRY_TO_EMAIL=ops@cleanship.co
