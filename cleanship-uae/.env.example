# This site is self-contained: no backend, no database. It only sends email.

# Email (Resend). The From address must be on a domain verified in Resend —
# cleanship.ae is verified; cleanship.co is not.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cleanship Sales <sales@cleanship.ae>
# Where enquiries land. Defaults to admin@cleanship.co when unset.
ENQUIRY_TO_EMAIL=admin@cleanship.co

# Cloudflare Turnstile. Add cleanship.ae to the widget's hostnames first.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 measurement ID for this domain (optional).
NEXT_PUBLIC_GA_ID=
