# Which site this deployment is. Required: "ae" for cleanship.ae, "gr" for cleanship.gr.
SITE=ae

# The CleanTrack API (same Render service the main site uses).
BACKEND_URL=https://YOUR-RENDER-SERVICE.onrender.com

# Proves enquiries came through this site's form. NOT the session secret itself —
# it is HMAC-SHA256(SESSION_SECRET, "cleanship-enquiry-form") as hex. Generate with:
#   node -e "console.log(require('crypto').createHmac('sha256', process.env.S).update('cleanship-enquiry-form').digest('hex'))"
# run with S=<the backend's SESSION_SECRET>.
ENQUIRY_FORM_KEY=

# Email (same Resend account and verified domain as cleanship.co).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cleanship Website <website@cleanship.co>
ENQUIRY_TO_EMAIL=admin@cleanship.co

# Cloudflare Turnstile. Add cleanship.ae and cleanship.gr to the widget's hostnames.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 measurement ID for this domain (optional).
NEXT_PUBLIC_GA_ID=
