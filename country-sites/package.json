{
  "name": "cleanship-country-sites",
  "version": "1.0.0",
  "private": true,
  "description": "cleanship.ae and cleanship.gr — two country sites from one codebase. SITE=ae or SITE=gr picks which one builds.",
  "scripts": {
    "dev": "next dev",
    "dev:ae": "SITE=ae next dev -p 3100",
    "dev:gr": "SITE=gr next dev -p 3200",
    "build": "next build",
    "build:ae": "SITE=ae next build",
    "build:gr": "SITE=gr next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
